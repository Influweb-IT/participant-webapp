# Generated by participant-webapp-template: change it there, then `copier update`.
#
# Build args:
#   ENV_FILE  optional env file baked in as .env.production.local (highest precedence),
#             overriding .env, e.g. --build-arg ENV_FILE=.env.staging
#
# Build with --pull so `apk upgrade` picks up the Alpine fixes released for the pins.

# build environment
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
COPY . .
ARG ENV_FILE=""
RUN if [ -n "$ENV_FILE" ]; then cp "$ENV_FILE" .env.production.local; fi
RUN yarn build

# production environment
# unprivileged nginx: runs as uid 101, listens on 8080, pid and temp files in /tmp
FROM nginx/nginx-unprivileged:1.30.6-alpine3.24
USER root
RUN apk upgrade --no-cache
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/snippets/ /etc/nginx/snippets/
USER 101
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
